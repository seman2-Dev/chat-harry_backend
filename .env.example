# Copy to .env and fill in real values. Never commit .env.

# Local: `npm run db:start` inside cat_harry_fontend starts a mongod that both
# apps share. The database name comes from the URI path (/studiospace).
MONGODB_URI=mongodb://127.0.0.1:27017/studiospace

PORT=5000

# MUST be identical to BETTER_AUTH_SECRET in cat_harry_fontend/.env.local —
# otherwise a session cookie issued by the Next.js app fails here (and back).
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of this API. Keep it equal to the origin clients actually use:
# http://localhost:5000 when calling this server directly, or the frontend
# origin (http://localhost:3000) once auth is proxied through Next (backend.md).
BETTER_AUTH_URL=http://localhost:5000

# Comma-separated browser origins allowed to send credentialed requests.
CLIENT_ORIGINS=http://localhost:3000

# Optional imgbb key for authenticated studio image uploads.
IMGBB_API_KEY=

# Optional Google OAuth — leave empty and the Google button stays disabled.
# (Legacy BETTER_AUTH_GOOGLE_* names are accepted too.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
